# CDOT-iwf runtime environment — sourced by bin/cdot_iwf at start.
# Lives in the running environment (etc/); contains no source.

# Config file (absolute path inside the install root).
IWF_CONFIG=/opt/CDOT-iwf/etc/config.yaml

# Log verbosity: trace|debug|info|warn|error
IWF_LOG_LEVEL=info

# Admin API JWT signing secret (HS256). CHANGE THIS in production.
IWF_ADMIN_JWT_SECRET=dev-secret

# NRF discovery requester NF type. A 5GC NRF authorizes NF discovery by
# requester type: Open5GS returns the UDM to AUSF/AMF/SMF/SCP, not AF/NEF.
# Use AUSF for Open5GS.
IWF_NRF_REQUESTER_NF_TYPE=AUSF

# Leave IWF_SBA_HTTP1 UNSET for a real 5GC (SBI is HTTP/2 cleartext).
# Set it to 1 only when pointing at HTTP/1.1 test mocks.

export IWF_CONFIG IWF_LOG_LEVEL IWF_ADMIN_JWT_SECRET IWF_NRF_REQUESTER_NF_TYPE
